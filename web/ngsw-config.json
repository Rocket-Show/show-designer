{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/media/*.woff2", "/media/*.woff"]
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    },
    {
      "name": "other-fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/media/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    }
  ]
}
